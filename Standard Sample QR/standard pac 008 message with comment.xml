						{ "value": "ONLPUR", "label": "Online Purchase" },
						{ "value": "SALA", "label": "Salary Payments" },
						{ "value": "GOVTP", "label": "Government Payments" },
						{ "value": "AIRTK", "label": "Airline Tickets" },
						{ "value": "BCLUB", "label": "Bars and Clubs" },
